rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myAdminDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function myRole() {
      return myAdminDoc()
        ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role
        : null;
    }

    function isMaster() {
      return myRole() == "master";
    }

    function isSuperAdmin() {
      return myRole() == "super_admin";
    }

    function isAdminManager() {
      return isMaster() || isSuperAdmin();
    }

    function isActiveAdmin() {
      return signedIn()
        && myAdminDoc()
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.status == "active"
        && myRole() in ["master", "super_admin", "admin", "viewer"];
    }

    function blockedBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/user_blocks/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/user_blocks/$(secondUid)/blocked/$(firstUid));
    }

    function requestBlockedAfter(firstUid, secondUid) {
      return existsAfter(/databases/$(database)/documents/user_blocks/$(firstUid)/blocked/$(secondUid))
        || existsAfter(/databases/$(database)/documents/user_blocks/$(secondUid)/blocked/$(firstUid));
    }

    // One friend request document per user pair, regardless of direction.
    function pairRequestId(firstUid, secondUid) {
      return firstUid < secondUid
        ? firstUid + "_" + secondUid
        : secondUid + "_" + firstUid;
    }

    // Contacts may only be created in the same batch that moves the pair's
    // request from pending to accepted, so an old accepted request is never
    // reusable. Display fields are bound to the request or the accepter's
    // presence instead of being chosen freely by the writer.
    function validAcceptedContact(uid, friendUid) {
      let requestPath = /databases/$(database)/documents/friend_requests/$(request.resource.data.requestId);
      let presencePath = /databases/$(database)/documents/presence/$(request.auth.uid);
      return request.resource.data.requestId == pairRequestId(uid, friendUid)
        && exists(requestPath)
        && get(requestPath).data.status == "pending"
        && getAfter(requestPath).data.status == "accepted"
        && getAfter(requestPath).data.toUid == request.auth.uid
        && ((uid == getAfter(requestPath).data.fromUid && friendUid == getAfter(requestPath).data.toUid)
          || (uid == getAfter(requestPath).data.toUid && friendUid == getAfter(requestPath).data.fromUid))
        && !requestBlockedAfter(uid, friendUid)
        && (friendUid == getAfter(requestPath).data.fromUid
          ? (request.resource.data.displayName == getAfter(requestPath).data.fromDisplayName
              || (getAfter(requestPath).data.fromDisplayName == "" && request.resource.data.displayName == "Jemaat SIPAPUA"))
            && request.resource.data.photoURL == getAfter(requestPath).data.fromPhotoURL
          : (exists(presencePath)
            ? (request.resource.data.displayName == get(presencePath).data.displayName
                || (get(presencePath).data.displayName == "" && request.resource.data.displayName == "Jemaat SIPAPUA"))
              && request.resource.data.photoURL == get(presencePath).data.photoURL
            : request.resource.data.displayName == "Jemaat SIPAPUA" && request.resource.data.photoURL == ""));
    }

    function validPresence() {
      return request.resource.data.keys().hasOnly([
          "online", "lastSeen", "displayName", "photoURL", "updatedAt",
          "discoverable", "showOnline", "komsel", "wilayah"
        ])
        && request.resource.data.keys().hasAll([
          "online", "lastSeen", "displayName", "photoURL", "updatedAt",
          "discoverable", "showOnline", "komsel", "wilayah"
        ])
        && request.resource.data.online is bool
        && request.resource.data.discoverable is bool
        && request.resource.data.showOnline is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.komsel is string
        && request.resource.data.komsel.size() <= 120
        && request.resource.data.wilayah is string
        && request.resource.data.wilayah.size() <= 120
        && request.resource.data.lastSeen == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function targetIsMaster() {
      return resource.data.role == "master"
        || resource.data.protected == true;
    }

    function newTargetIsMaster() {
      return request.resource.data.role == "master"
        || request.resource.data.protected == true;
    }

    // =========================================================
    // ADMIN USERS - SECURED PHASE 1
    // =========================================================
    match /admin_users/{uid} {

      // Dashboard admin management membutuhkan daftar admin.
      allow read: if signedIn() && (uid == request.auth.uid || isAdminManager());

      // Membuat akun admin baru:
      // Master boleh membuat semua non-master.
      // Super Admin hanya boleh membuat admin/viewer.
      allow create: if
        (
          isMaster()
          && request.resource.data.role in ["super_admin", "admin", "viewer"]
          && request.resource.data.protected == false
        )
        ||
        (
          isSuperAdmin()
          && request.resource.data.role in ["admin", "viewer"]
          && request.resource.data.protected == false
        );

      // Update:
      // Master boleh mengelola akun non-master.
      // Master sendiri hanya boleh mempertahankan role master/protected.
      // Super Admin tidak boleh menyentuh Master.
      allow update: if
        (
          isMaster()
          && uid == request.auth.uid
          && resource.data.role == "master"
          && request.resource.data.role == "master"
          && request.resource.data.protected == true
          && request.resource.data.status == "active"
        )
        ||
        (
          isMaster()
          && uid != request.auth.uid
          && !targetIsMaster()
          && !newTargetIsMaster()
        )
        ||
        (
          isSuperAdmin()
          && !targetIsMaster()
          && !newTargetIsMaster()
          && request.resource.data.role in ["admin", "viewer"]
        );

      // Hapus langsung dari admin_users kita tahan dulu.
      // Modul sekarang menggunakan status inactive.
      allow delete: if false;
    }
    // =========================================================
    // SIPAPUA NEWS - SECURED
    // =========================================================

    function isNewsAdmin() {
      return signedIn()
        && myRole() in ["master", "super_admin", "admin", "viewer"];
    }

    function isNewsEditor() {
      return signedIn()
        && myRole() in ["master", "super_admin", "admin"];
    }

    match /sipapua_news/{newsId} {
      allow read: if
        resource.data.status == "published"
        || isNewsAdmin();

      allow create: if
        isNewsEditor()
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        isNewsEditor()
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if
        signedIn()
        && myRole() in ["master", "super_admin"];
    }
    // =========================================================
    // SIPAPUA POPUP BANNER - SECURED
    // =========================================================

    function isPopupAdmin() {
      return signedIn()
        && myRole() in ["master", "super_admin", "admin", "viewer"];
    }

    function isPopupEditor() {
      return signedIn()
        && myRole() in ["master", "super_admin", "admin"];
    }

    function isValidPopupSlot(slotId) {
      return slotId in [
        "popup_1",
        "popup_2",
        "popup_3",
        "popup_4",
        "popup_5"
      ];
    }

    match /sipapua_popups/{popupId} {
      allow read: if
        resource.data.status == "published" || isPopupAdmin();

      allow create: if
        isValidPopupSlot(popupId)
        && isPopupEditor()
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        isValidPopupSlot(popupId)
        && isPopupEditor()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ["draft", "published"];

      allow delete: if
        isValidPopupSlot(popupId)
        && signedIn()
        && myRole() in ["master", "super_admin"];
    }
    // EXISTING COLLECTIONS - TEMPORARY COMPATIBILITY
    // =========================================================

    match /jemaat/{document=**} {
      allow read, write: if true;
    }

    match /portal_media/{document=**} {
      allow read, write: if true;
    }

    match /config/{document=**} {
      allow read, write: if true;
    }

    match /users/{uid} {
      // Profile reads remain compatible with existing registration lookups.
      // Writes must come from the profile owner or an active administrator.
      allow read: if true;
      allow create: if isActiveAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status_akun == "Menunggu Verifikasi");

      allow update: if isActiveAdmin()
        || (signedIn()
          && (request.auth.uid == uid
            || resource.data.get("uid", "") == request.auth.uid)
          && !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(["status_akun"]));
      allow delete: if isActiveAdmin()
        || (signedIn()
          && (request.auth.uid == uid
            || resource.data.get("uid", "") == request.auth.uid));
    }

    match /users/{uid}/{subcollection}/{document=**} {
      allow read: if true;
      allow write: if isActiveAdmin()
        || (signedIn() && request.auth.uid == uid);
    }

    match /login_logs/{document=**} {
      allow read, write: if true;
    }

    match /agenda_tahunan/{document=**} {
      allow read, write: if true;
    }

    match /saran_masukan/{document=**} {
      allow read, write: if true;
    }

    match /umkm_stores/{document=**} {
      allow read, write: if true;
    }

    match /umkm_products/{document=**} {
      allow read, write: if true;
    }

    match /rating_toko/{document=**} {
      allow read, write: if true;
    }

    match /chats/{document=**} {
      allow read, write: if true;
    }

    // SOCIAL PRESENCE - public fields only; exact GPS coordinates are private.
    match /presence/{uid} {
      allow read: if signedIn()
        && (uid == request.auth.uid
          || (resource.data.discoverable == true
            && resource.data.showOnline == true
            && !blockedBetween(uid, request.auth.uid)));

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && validPresence();

      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /presence_locations/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["latitude", "longitude", "updatedAt"])
        && request.resource.data.keys().hasAll(["latitude", "longitude", "updatedAt"])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.keys().hasAll([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && requestId == pairRequestId(request.resource.data.fromUid, request.resource.data.toUid)
        && exists(/databases/$(database)/documents/presence/$(request.auth.uid))
        && request.resource.data.fromDisplayName == get(/databases/$(database)/documents/presence/$(request.auth.uid)).data.displayName
        && request.resource.data.fromPhotoURL == get(/databases/$(database)/documents/presence/$(request.auth.uid)).data.photoURL
        && exists(/databases/$(database)/documents/presence/$(request.resource.data.toUid))
        && get(/databases/$(database)/documents/presence/$(request.resource.data.toUid)).data.discoverable == true
        && request.resource.data.status == "pending"
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() <= 100
        && request.resource.data.fromPhotoURL is string
        && request.resource.data.fromPhotoURL.size() <= 2048
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !blockedBetween(request.auth.uid, request.resource.data.toUid);

      allow update: if signedIn()
        && resource.data.status in ["pending", "accepted"]
        && request.resource.data.keys().hasOnly([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.keys().hasAll([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.fromDisplayName == resource.data.fromDisplayName
        && request.resource.data.fromPhotoURL == resource.data.fromPhotoURL
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == "pending"
            && resource.data.toUid == request.auth.uid
            && request.resource.data.status == "rejected")
          || (resource.data.status == "pending"
            && resource.data.toUid == request.auth.uid
            && request.resource.data.status == "accepted"
            && !requestBlockedAfter(resource.data.fromUid, resource.data.toUid))
          || (request.resource.data.status == "blocked"
            && resource.data.fromUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(resource.data.toUid)))
          || (request.resource.data.status == "blocked"
            && resource.data.toUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(resource.data.fromUid)))
        );

      // Sender may cancel a pending request. A blocked pair's request may be
      // cleared by either side only once no block remains, so the pair can
      // connect again after unblocking.
      allow delete: if signedIn()
        && (
          (resource.data.fromUid == request.auth.uid
            && resource.data.status == "pending")
          || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && resource.data.status == "blocked"
            && !requestBlockedAfter(resource.data.fromUid, resource.data.toUid))
        );
    }

    match /contacts/{uid}/friends/{friendUid} {
      allow read: if signedIn() && uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "friendUid", "createdAt", "displayName", "photoURL", "status", "requestId"
        ])
        && request.resource.data.keys().hasAll([
          "friendUid", "createdAt", "displayName", "photoURL", "status", "requestId"
        ])
        && request.resource.data.friendUid == friendUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.status == "accepted"
        && validAcceptedContact(uid, friendUid);

      allow update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.friendUid == resource.data.friendUid
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.status == "accepted"
        && request.resource.data.createdAt == resource.data.createdAt;

      // Owner may remove any entry. A user who has blocked the owner may only
      // remove their own entry from the owner's list (block cleanup).
      allow delete: if signedIn()
        && (uid == request.auth.uid
          || (friendUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(uid))));
    }

    match /user_blocks/{uid}/blocked/{blockedUid} {
      allow read: if signedIn() && uid == request.auth.uid;

      allow create: if signedIn()
        && uid == request.auth.uid
        && blockedUid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          "blockedUid", "createdAt", "displayName", "photoURL"
        ])
        && request.resource.data.keys().hasAll([
          "blockedUid", "createdAt", "displayName", "photoURL"
        ])
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;

      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Game leaderboard: one document per player, keyed by auth uid. Points are earned
    // client-side (20 per correct answer, up to 100 questions per round), so each write may
    // add at most one full round (2000) and the running total can never go down.
    function validGameScore(uid) {
      let data = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && data.uid == uid
        && data.keys().hasOnly(['uid', 'nama', 'skor', 'streak', 'predikat', 'updatedAt'])
        && data.keys().hasAll(['uid', 'nama', 'skor', 'streak', 'predikat', 'updatedAt'])
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 80
        && data.skor is int && data.skor >= 0 && data.skor % 20 == 0
        && data.streak is int && data.streak >= 0 && data.streak <= 100000
        && data.predikat == (data.streak >= 7 ? '🏆 GOLD'
          : data.streak >= 4 ? '🥈 SILVER'
          : data.streak >= 2 ? '🥉 BRONZE' : '')
        && data.updatedAt == request.time;
    }

    match /game_scores/{uid} {
      allow read: if signedIn();
      allow create: if validGameScore(uid)
        && request.resource.data.skor <= 2000;
      allow update: if validGameScore(uid)
        && request.resource.data.skor >= resource.data.skor
        && request.resource.data.skor - resource.data.skor <= 2000;
      allow delete: if isActiveAdmin();
    }

    match /pengumuman_komsel/{document=**} {
      allow read, write: if true;
    }

    match /laporan_doa/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /laporan_bacaan/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /kehadiran_jemaat/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /laporan_komsel_umum/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /statistik_jemaat_pusat/{document=**} {
      // Raw report copies remain internal to active administrators.
      allow read: if isActiveAdmin();

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /laporan_pelayanan/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /kehadiran/{document=**} {
      allow read, write: if true;
    }

    match /kesaksian/{document=**} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.author_uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.author_uid == request.auth.uid;
    }

    match /running_text_history/{document=**} {
      allow read, write: if true;
    }

    match /pks_users/{uid} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && uid == request.auth.uid);

      allow create, update, delete: if false;
    }
    match /event_user_hidden/{uid}/events/{eventId} {
      allow read: if
        signedIn()
        && uid == request.auth.uid;

      allow create, update: if
        signedIn()
        && uid == request.auth.uid
        && request.resource.data.hidden == true;

      allow delete: if
        signedIn()
        && uid == request.auth.uid;
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
