// REVIEW CANDIDATE: unknown UID ownership fails closed; trusted per-UID review required.
// Production index NOT provisioned. Not selected by firebase.json. Legacy linking DISABLED.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myAdminDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function myRole() {
      return myAdminDoc()
        ? get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role
        : null;
    }

    function isMaster() {
      return isActiveAdmin() && myRole() == "master";
    }

    function isSuperAdmin() {
      return isActiveAdmin() && myRole() == "super_admin";
    }

    function isAdminManager() {
      return isMaster() || isSuperAdmin();
    }

    function isActiveAdmin() {
      return signedIn()
        && myAdminDoc()
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.status == "active"
        && myRole() in ["master", "super_admin", "admin", "viewer"];
    }

    function blockedBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/user_blocks/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/user_blocks/$(secondUid)/blocked/$(firstUid));
    }

    function requestBlockedAfter(firstUid, secondUid) {
      return existsAfter(/databases/$(database)/documents/user_blocks/$(firstUid)/blocked/$(secondUid))
        || existsAfter(/databases/$(database)/documents/user_blocks/$(secondUid)/blocked/$(firstUid));
    }

    // One friend request document per user pair, regardless of direction.
    function pairRequestId(firstUid, secondUid) {
      return firstUid < secondUid
        ? firstUid + "_" + secondUid
        : secondUid + "_" + firstUid;
    }

    // Contacts may only be created in the same batch that moves the pair's
    // request from pending to accepted, so an old accepted request is never
    // reusable. Display fields are bound to the request or the accepter's
    // presence instead of being chosen freely by the writer.
    function validAcceptedContact(uid, friendUid) {
      let requestPath = /databases/$(database)/documents/friend_requests/$(request.resource.data.requestId);
      let presencePath = /databases/$(database)/documents/presence/$(request.auth.uid);
      return request.resource.data.requestId == pairRequestId(uid, friendUid)
        && exists(requestPath)
        && get(requestPath).data.status == "pending"
        && getAfter(requestPath).data.status == "accepted"
        && getAfter(requestPath).data.toUid == request.auth.uid
        && ((uid == getAfter(requestPath).data.fromUid && friendUid == getAfter(requestPath).data.toUid)
          || (uid == getAfter(requestPath).data.toUid && friendUid == getAfter(requestPath).data.fromUid))
        && !requestBlockedAfter(uid, friendUid)
        && (friendUid == getAfter(requestPath).data.fromUid
          ? (request.resource.data.displayName == getAfter(requestPath).data.fromDisplayName
              || (getAfter(requestPath).data.fromDisplayName == "" && request.resource.data.displayName == "Jemaat SIPAPUA"))
            && request.resource.data.photoURL == getAfter(requestPath).data.fromPhotoURL
          : (exists(presencePath)
            ? (request.resource.data.displayName == get(presencePath).data.displayName
                || (get(presencePath).data.displayName == "" && request.resource.data.displayName == "Jemaat SIPAPUA"))
              && request.resource.data.photoURL == get(presencePath).data.photoURL
            : request.resource.data.displayName == "Jemaat SIPAPUA" && request.resource.data.photoURL == ""));
    }

    function validPresence() {
      return request.resource.data.keys().hasOnly([
          "online", "lastSeen", "displayName", "photoURL", "updatedAt",
          "discoverable", "showOnline", "komsel", "wilayah"
        ])
        && request.resource.data.keys().hasAll([
          "online", "lastSeen", "displayName", "photoURL", "updatedAt",
          "discoverable", "showOnline", "komsel", "wilayah"
        ])
        && request.resource.data.online is bool
        && request.resource.data.discoverable is bool
        && request.resource.data.showOnline is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.komsel is string
        && request.resource.data.komsel.size() <= 120
        && request.resource.data.wilayah is string
        && request.resource.data.wilayah.size() <= 120
        && request.resource.data.lastSeen == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function targetIsMaster() {
      return resource.data.role == "master"
        || resource.data.protected == true;
    }

    function newTargetIsMaster() {
      return request.resource.data.role == "master"
        || request.resource.data.protected == true;
    }

    // =========================================================
    // ADMIN USERS - SECURED PHASE 1
    // =========================================================
    match /admin_users/{uid} {

      // Dashboard admin management membutuhkan daftar admin.
      allow read: if signedIn() && (uid == request.auth.uid || isAdminManager());

      // Membuat akun admin baru:
      // Master boleh membuat semua non-master.
      // Super Admin hanya boleh membuat admin/viewer.
      allow create: if
        (
          isMaster()
          && request.resource.data.role in ["super_admin", "admin", "viewer"]
          && request.resource.data.protected == false
        )
        ||
        (
          isSuperAdmin()
          && request.resource.data.role in ["admin", "viewer"]
          && request.resource.data.protected == false
        );

      // Update:
      // Master boleh mengelola akun non-master.
      // Master sendiri hanya boleh mempertahankan role master/protected.
      // Super Admin tidak boleh menyentuh Master.
      allow update: if
        (
          isMaster()
          && uid == request.auth.uid
          && resource.data.role == "master"
          && request.resource.data.role == "master"
          && request.resource.data.protected == true
          && request.resource.data.status == "active"
        )
        ||
        (
          isMaster()
          && uid != request.auth.uid
          && !targetIsMaster()
          && !newTargetIsMaster()
        )
        ||
        (
          isSuperAdmin()
          && !targetIsMaster()
          && !newTargetIsMaster()
          && request.resource.data.role in ["admin", "viewer"]
        );

      // Hapus langsung dari admin_users kita tahan dulu.
      // Modul sekarang menggunakan status inactive.
      allow delete: if false;
    }
    // =========================================================
    // SIPAPUA NEWS - SECURED
    // =========================================================

    function isNewsAdmin() {
      return isActiveAdmin()
        && myRole() in ["master", "super_admin", "admin", "viewer"];
    }

    function isNewsEditor() {
      return isActiveAdmin()
        && myRole() in ["master", "super_admin", "admin"];
    }

    match /sipapua_news/{newsId} {
      allow read: if
        resource.data.status == "published"
        || isNewsAdmin();

      allow create: if
        isNewsEditor()
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        isNewsEditor()
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if
        isActiveAdmin()
        && myRole() in ["master", "super_admin"];
    }
    // =========================================================
    // SIPAPUA POPUP BANNER - SECURED
    // =========================================================

    function isPopupAdmin() {
      return isActiveAdmin()
        && myRole() in ["master", "super_admin", "admin", "viewer"];
    }

    function isPopupEditor() {
      return isActiveAdmin()
        && myRole() in ["master", "super_admin", "admin"];
    }

    function isValidPopupSlot(slotId) {
      return slotId in [
        "popup_1",
        "popup_2",
        "popup_3",
        "popup_4",
        "popup_5"
      ];
    }

    match /sipapua_popups/{popupId} {
      allow read: if
        resource.data.status == "published" || isPopupAdmin();

      allow create: if
        isValidPopupSlot(popupId)
        && isPopupEditor()
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if
        isValidPopupSlot(popupId)
        && isPopupEditor()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ["draft", "published"];

      allow delete: if
        isValidPopupSlot(popupId)
        && isActiveAdmin()
        && myRole() in ["master", "super_admin"];
    }
    // EXISTING COLLECTIONS - TEMPORARY COMPATIBILITY
    // =========================================================

    match /jemaat/{document} {
      allow read, write: if isActiveAdmin(); // Private legacy member records.
    }

    match /portal_media/{document} {
      allow read: if signedIn();
      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin() && myRole() != "viewer";
    }

    match /config/{document} {
      allow read: if isActiveAdmin() || (signedIn() && document in ["playlist","running_text"]);
      allow write: if isActiveAdmin();
    }

    // RELEASE 005A PROPOSAL: REVIEW ONLY; not referenced by firebase.json.
    // Client lifecycle operations need compatible trusted services before adoption.
    function ownsProfile(uid) {
      return signedIn() && ((request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/users/$(uid)) || resource.data.get('uid','') in ['',request.auth.uid]))
        || resource.data.get('uid','') == request.auth.uid);
    }
    function activationManager() {
      return isAdminManager() && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.get('permissions',{}).get('canActivateMembers',false) == true;
    }
    function finalActivation(profileId, before, after) {
      let audit = getAfter(/databases/$(database)/documents/registration_audit/$(after.activation.auditId)).data;
      let verified = request.auth.uid == before.uid && request.auth.token.get('email_verified',false) == true
        && before.get('email_normalized','') == request.auth.token.email.lower()
        && profileId == request.auth.uid
        && get(/databases/$(database)/documents/nij_allocations/$(profileId)).data.nij == before.nij;
      let manual = activationManager();
      return before.get('uid','') is string && before.get('uid','') != ''
        && before.status_akun in ['Pending','Menunggu Verifikasi'] && after.status_akun == 'Aktif'
        && after.diff(before).affectedKeys().hasOnly(['status_akun','activation','initial_verification_status'])
        && after.initial_verification_status == before.status_akun
        && after.activation.keys().hasOnly(['method','at','auditId']) && after.activation.at == request.time
        && ((verified && before.status_akun == 'Menunggu Verifikasi' && after.activation.method == 'verified-email')
          || (manual && after.activation.method == 'admin-override'))
        && !exists(/databases/$(database)/documents/registration_audit/$(after.activation.auditId))
        && audit == {'uid':before.uid,'targetUid':before.uid,'profileId':profileId,'actorUid':request.auth.uid,
          'action':after.activation.method == 'verified-email' ? 'activate-verified-email' : 'activate-admin-override',
          'activationPath':after.activation.method,'previousStatus':before.status_akun,'newStatus':'Aktif',
          'identityVerificationAttested':after.activation.method == 'admin-override','createdAt':request.time};
    }
    function safeProfileEdit(uid) {
      return (ownsProfile(uid) || isActiveAdmin()) && keepsRegistrationIdentity()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama','nama_lengkap','tgl_lahir','tanggal_lahir','tanggal_lahir_murni','jenis_kelamin','sudah_dibaptis',
          'pemuridan_kd','pemuridan_kd_angkatan','sudah_alpha','alpha_angkatan','darah','provinsi','kabupaten_kota',
          'kota','kecamatan','desa_kelurahan','desa','alamat_detail','alamat','provinsi_lahir','kota_lahir',
          'kecamatan_lahir','desa_lahir','pekerjaan','status_pernikahan','nama_pasangan','komsel','jabatan',
          'sub_jabatan','sub_bidang','pelayanan','detail_pelayanan','foto_profil','last_update']);
    }
    function profileDelete(profileId, before) {
      return signedIn() && ((request.auth.uid == profileId && before.get('uid','') in ['',request.auth.uid]) || before.get('uid','') == request.auth.uid || isAdminManager())
        && !exists(/databases/$(database)/documents/registration_audit/$('profile-delete_' + profileId))
        && getAfter(/databases/$(database)/documents/registration_audit/$('profile-delete_' + profileId)).data == {
          'action':'profile-delete','actorUid':request.auth.uid,'targetUid':before.get('uid','') != '' ? before.uid : profileId,
          'profileId':profileId,'createdAt':request.time};
    }
    function familyProfileEdit(uid) {
      return (ownsProfile(uid) || isActiveAdmin()) && keepsRegistrationIdentity()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'anak','jumlah_anak','nama_ayah','nama_ibu','orang_tua_berjemaat','wilayah_orang_tua'])
        && request.resource.data.get('jumlah_anak',0) == request.resource.data.get('anak',[]).size()
        && sparkAppend(resource.data.get('anak',[]),request.resource.data.get('anak',[]));
    }
    function contactProof(profileId, before, after) {
      let owner = before.get('uid','') != '' ? before.uid : profileId;
      let changedEmail = after.email.lower() != before.email.lower();
      let changedPhone = after.get('whatsapp_normalized','') != before.get('whatsapp_normalized','');
      return signedIn() && (request.auth.uid == owner || isActiveAdmin()) && (changedEmail || changedPhone)
        && !after.diff(before).affectedKeys().hasAny(['uid','nij','nij_number','wilayah','createdAt','status_akun','activation','initial_verification_status','role','permissions','isAdmin'])
        && after.diff(before).affectedKeys().hasOnly(['email','email_normalized','whatsapp','whatsapp_normalized','lastContactAuditId',
          'nama','nama_lengkap','tgl_lahir','tanggal_lahir','tanggal_lahir_murni','jenis_kelamin','sudah_dibaptis','pemuridan_kd',
          'pemuridan_kd_angkatan','sudah_alpha','alpha_angkatan','darah','provinsi','kabupaten_kota','kota','kecamatan','desa_kelurahan',
          'desa','alamat_detail','alamat','provinsi_lahir','kota_lahir','kecamatan_lahir','desa_lahir','pekerjaan','status_pernikahan',
          'nama_pasangan','komsel','jabatan','sub_jabatan','sub_bidang','pelayanan','detail_pelayanan','foto_profil','last_update'])
        && (!changedEmail || (request.auth.uid == owner && after.email_normalized == request.auth.token.email.lower()
          && after.email.lower() == after.email_normalized
          && getAfter(/databases/$(database)/documents/registration_unique/$(sparkEmailKey(after.email_normalized))).data.uid == owner))
        && (!changedPhone || (after.whatsapp_normalized.matches('^62[0-9]{8,13}$')
          && after.whatsapp.replace('[^0-9]','').replace('^0','62') == after.whatsapp_normalized
          && getAfter(/databases/$(database)/documents/registration_unique/$('phone_' + after.whatsapp_normalized)).data.uid == owner))
        && !exists(/databases/$(database)/documents/registration_audit/$(after.lastContactAuditId))
        && getAfter(/databases/$(database)/documents/registration_audit/$(after.lastContactAuditId)).data == {
          'action':'profile-contact-update','actorUid':request.auth.uid,'targetUid':owner,'profileId':profileId,'createdAt':request.time};
    }
    function contactClaim(id) {
      let profileId = request.resource.data.profileId;
      let before = get(/databases/$(database)/documents/users/$(profileId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(profileId)).data;
      let owner = before.get('uid','') != '' ? before.uid : profileId;
      return contactProof(profileId,before,after)
        && request.resource.data == {'uid':owner,'profileId':profileId,'createdAt':request.time}
        && ((after.email.lower() != before.email.lower() && id == sparkEmailKey(after.email_normalized))
          || (after.get('whatsapp_normalized','') != before.get('whatsapp_normalized','') && id == 'phone_' + after.whatsapp_normalized));
    }
    function keepsRegistrationIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "uid", "nij", "nij_number", "wilayah", "email", "email_normalized",
        "whatsapp", "whatsapp_normalized", "createdAt", "status_akun",
        "activation", "initial_verification_status"
      ]);
    }
    // SPARK CANDIDATE: creation only. Existing identity/activation writers stay denied.
    function sparkRegion(code) {
      return {'ABE':'Abepura','STN':'Sentani','DYO':'Doyo','ARS1':'ARS1','ARS2':'ARS2'}[code];
    }
    function sparkEmailKey(email) {
      return 'email_' + email.replace('%', '%25').replace('/', '%2F');
    }
    function trustedUidClear(uid) {
      let o = get(/databases/$(database)/documents/uid_ownership/$(uid)).data;
      return o.uid == uid && o.state == 'clear' && o.profileId == ''
        && o.reviewId is string && o.reviewId.size() > 0
        && o.reviewedAt is timestamp && o.expiresAt is timestamp
        && o.reviewedAt <= request.time && o.expiresAt > request.time
        && o.expiresAt <= o.reviewedAt + duration.value(24,'h');
    }
    function allocatedUid(uid, nij) {
      let before = get(/databases/$(database)/documents/uid_ownership/$(uid)).data;
      let after = getAfter(/databases/$(database)/documents/uid_ownership/$(uid)).data;
      return trustedUidClear(uid)
        && after.diff(before).affectedKeys().hasOnly(['state','profileId','nij','allocatedAt'])
        && after.state == 'allocated' && after.profileId == uid
        && after.nij == nij && after.allocatedAt == request.time;
    }
    match /uid_ownership/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid && trustedUidClear(uid)
        && !exists(/databases/$(database)/documents/users/$(uid))
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.uid == uid
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.createdAt == request.time
        && allocatedUid(uid,getAfter(/databases/$(database)/documents/users/$(uid)).data.nij);
    }
    function sparkReady() {
      let s = get(/databases/$(database)/documents/registration_control/state).data;
      return s.enabled == true && s.maintenance == false && s.version == 'original-spark-v1';
    }
    function sparkNew(uid) {
      return signedIn() && request.auth.uid == uid && sparkReady() && trustedUidClear(uid)
        && !exists(/databases/$(database)/documents/nij_allocations/$(uid));
    }
    function sparkChild(c) { return c == {'nama':c.nama,'uid':'','nij':''} && c.nama is string && c.nama.size() <= 150; }
    function sparkAppend(before, after) {
      let n = before.size(); let m = after.size();
      return after is list && m <= 30 && (after == before || after == []
        || (m == n + 1 && after == before.concat([after[n + 0]])
          && sparkChild(after[n + 0]))
        || (m == n + 2 && after == before.concat([after[n + 0],after[n + 1]])
          && sparkChild(after[n + 0]) && sparkChild(after[n + 1]))
        || (m == n + 3 && after == before.concat([after[n + 0],after[n + 1],after[n + 2]])
          && sparkChild(after[n + 0]) && sparkChild(after[n + 1]) && sparkChild(after[n + 2]))
        || (m == n + 4 && after == before.concat([after[n + 0],after[n + 1],after[n + 2],after[n + 3]])
          && sparkChild(after[n + 0]) && sparkChild(after[n + 1]) && sparkChild(after[n + 2]) && sparkChild(after[n + 3]))
        || (m == n + 5 && after == before.concat([after[n + 0],after[n + 1],after[n + 2],after[n + 3],after[n + 4]])
          && sparkChild(after[n + 0]) && sparkChild(after[n + 1]) && sparkChild(after[n + 2]) && sparkChild(after[n + 3]) && sparkChild(after[n + 4]))); }
    function sparkNewFields(p) { return p.keys().hasOnly(["uid","nama","email","email_normalized","whatsapp","whatsapp_normalized","wilayah","provinsi","kabupaten_kota","kecamatan","desa_kelurahan","alamat_detail","provinsi_lahir","kota_lahir","kecamatan_lahir","desa_lahir","komsel","jabatan","sub_jabatan","pelayanan","detail_pelayanan","tgl_lahir","jenis_kelamin","sudah_dibaptis","pemuridan_kd","pemuridan_kd_angkatan","sudah_alpha","alpha_angkatan","darah","pekerjaan","nama_pasangan","jumlah_anak","anak","nama_ayah","nama_ayah_uid","nama_ayah_nij","nama_ibu","nama_ibu_uid","nama_ibu_nij","status_pernikahan","orang_tua_berjemaat","wilayah_orang_tua","status_akun","nij","nij_number","createdAt"])
        && p.get('nama_ayah_uid','') == '' && p.get('nama_ayah_nij','') == ''
        && p.get('nama_ibu_uid','') == '' && p.get('nama_ibu_nij','') == ''
        && p.get('anak',[]) == [] && p.get('jumlah_anak',0) == 0; }
    function sparkAnchor(uid) {
      let p = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/users/$(uid))
        && p.uid == uid && p.createdAt == request.time;
    }
    function sparkProof(uid) {
      let p = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let a = getAfter(/databases/$(database)/documents/nij_allocations/$(uid)).data;
      let c = get(/databases/$(database)/documents/nij_counters/$(a.wilayah)).data;
      let next = getAfter(/databases/$(database)/documents/nij_counters/$(a.wilayah)).data;
      let digits = a.nij_number < 10 ? '00' + string(a.nij_number) : (a.nij_number < 100 ? '0' + string(a.nij_number) : string(a.nij_number));
      let year = string((request.time + duration.value(9, 'h')).year());
      return a.keys().hasOnly(['uid','lokasi','wilayah','nij','nij_number','createdAt'])
        && a.uid == uid && allocatedUid(uid,a.nij) && a.wilayah == sparkRegion(a.lokasi)
        && c.last is int && c.last >= 0 && c.last < 999999999
        && a.nij_number is int && a.nij_number == c.last + 1
        && next.last == a.nij_number && next.updatedAt == request.time
        && next.diff(c).affectedKeys().hasOnly(['last','updatedAt'])
        && a.nij == 'NIJ-PPP-' + a.lokasi + '-' + digits + '-' + year
        && a.createdAt == request.time
        && p.uid == uid && p.nij == a.nij && p.nij_number == a.nij_number && p.wilayah == a.wilayah
        && p.createdAt == request.time && p.status_akun == 'Menunggu Verifikasi'
        && p.email == request.auth.token.email.lower() && p.email_normalized == p.email
        && p.whatsapp is string && p.whatsapp_normalized is string
        && p.whatsapp_normalized.matches('^62[0-9]{8,13}$')
        && p.whatsapp.replace('[^0-9]', '').replace('^0', '62') == p.whatsapp_normalized
        && true
        && getAfter(/databases/$(database)/documents/registration_unique/$(sparkEmailKey(p.email))).data == {'uid':uid,'createdAt':request.time}
        && getAfter(/databases/$(database)/documents/registration_unique/$('phone_' + p.whatsapp_normalized)).data == {'uid':uid,'createdAt':request.time};
    }
    match /users/{uid} {
      allow read: if ownsProfile(uid) || isActiveAdmin();
      allow create: if sparkNew(uid) && sparkProof(uid) && sparkNewFields(request.resource.data);
      allow update: if safeProfileEdit(uid) || familyProfileEdit(uid) || (signedIn() && (contactProof(uid,resource.data,request.resource.data) || finalActivation(uid,resource.data,request.resource.data)));
      allow delete: if profileDelete(uid,resource.data);
    }
    match /users/{uid}/{subcollection}/{document=**} {
      allow read, write: if isActiveAdmin() || (signedIn() && request.auth.uid == uid && get(/databases/$(database)/documents/users/$(uid)).data.get('uid','') in ['',request.auth.uid]);
    }
    match /nij_allocations/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if sparkAnchor(uid);
      allow update, delete: if false;
    }
    match /nij_counters/{id} {
      allow get: if signedIn();
      allow update: if sparkAnchor(request.auth.uid)
        && getAfter(/databases/$(database)/documents/nij_allocations/$(request.auth.uid)).data.wilayah == id;
      allow create, delete, list: if false;
    }
    match /registration_unique/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/registration_unique/$(id)) || resource.data.uid == request.auth.uid);
      allow create: if sparkAnchor(request.auth.uid)
        && (id == sparkEmailKey(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email)
          || id == 'phone_' + getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.whatsapp_normalized)
        && request.resource.data == {'uid':request.auth.uid,'createdAt':request.time}
        || (signedIn() && contactClaim(id));
      allow update, delete, list: if false;
    }
    match /registration_control/{id} {
      allow get: if id == 'state';
      allow write, list: if false;
    }
    match /registration_audit/{id} {
      allow read: if isActiveAdmin();
      allow create: if signedIn() && (
        (request.resource.data.get('action','') == 'profile-contact-update'
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data.lastContactAuditId == id
          && contactProof(request.resource.data.profileId,get(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data,
            getAfter(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data))
        ||
        (request.resource.data.get('action','') == 'profile-delete'
          && id == 'profile-delete_' + request.resource.data.profileId
          && !existsAfter(/databases/$(database)/documents/users/$(request.resource.data.profileId))
          && profileDelete(request.resource.data.profileId,get(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data))
        || (
        request.resource.data.get('action','') in ['activate-verified-email','activate-admin-override']
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data.activation.auditId == id
        && finalActivation(request.resource.data.profileId,
          get(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data,
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.profileId)).data)));
      allow update, delete: if false;
    }
    match /member_identity/{id} { allow read, write: if false; }
    match /legacy_profile_owners/{id} { allow read, write: if false; }
    match /legacy_link_requests/{id} { allow read, write: if false; }
    match /legacy_link_approvals/{id} { allow read, write: if false; }
    match /family_link_consents/{id} { allow read, write: if false; }
    match /family_lookup_limits/{id} { allow read, write: if false; }

    match /login_logs/{document} {
      allow read: if isActiveAdmin();
      allow write: if false; // Telemetry needs a trusted writer.
    }

    match /agenda_tahunan/{document} {
      allow read: if signedIn();
      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin() && myRole() in ["master","super_admin"];
    }

    match /saran_masukan/{document} {
      allow read: if isActiveAdmin() || (signedIn() && resource.data.get("uid","") == request.auth.uid);
      allow create: if signedIn() && request.resource.data.get("uid","") == request.auth.uid
        && request.resource.data.email == request.auth.token.get("email","")
        && request.resource.data.status == "proses" && request.resource.data.timestamp == request.time;
      allow update, delete: if isActiveAdmin();
    }

    match /umkm_stores/{document} {
      allow read: if isActiveAdmin() || (signedIn() && document == request.auth.uid);
      allow create: if isActiveAdmin();
      allow update: if isActiveAdmin() || (signedIn() && document == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status","uid","email"]));
      allow delete: if isActiveAdmin();
    }

    match /umkm_products/{document} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.seller_uid == request.auth.uid;
      allow update: if isActiveAdmin() || (signedIn() && resource.data.seller_uid == request.auth.uid
        && request.resource.data.seller_uid == resource.data.seller_uid);
      allow delete: if isActiveAdmin() || (signedIn() && resource.data.seller_uid == request.auth.uid);
    }

    match /rating_toko/{document} {
      allow read: if isActiveAdmin() || (signedIn() && resource.data.seller_uid == request.auth.uid);
      allow write: if false; // No rating writer with a verified ownership contract found.
    }

    match /chats/{document} {
      function chatIdentity() {
        return signedIn() && (request.auth.token.get("firebase", {}).get("sign_in_provider", "") != "anonymous"
          || request.auth.token.aud == "demo-sipapua-guest-chat-closeout");
      }
      function validMessage() {
        let data = request.resource.data;
        return data.keys().hasOnly(["seller_uid", "customer_id", "sender", "message", "timestamp",
            "is_read", "deleted_by_seller", "is_product", "product_img", "customer_name"])
          && data.seller_uid is string && data.seller_uid.size() > 0 && data.seller_uid.size() <= 128
          && data.customer_id is string && data.customer_id.size() > 0 && data.customer_id.size() <= 128
          && data.message is string && data.message.size() > 0 && data.message.size() <= 4000
          && data.timestamp == request.time && data.is_read == false && data.deleted_by_seller == false;
      }
      allow read: if isActiveAdmin() || (chatIdentity()
        && (resource.data.seller_uid == request.auth.uid || resource.data.customer_id == request.auth.uid));
      allow create: if chatIdentity() && validMessage()
        && ((request.resource.data.sender == "customer" && request.resource.data.customer_id == request.auth.uid)
          || (request.resource.data.sender == "seller" && request.resource.data.seller_uid == request.auth.uid));
      allow update: if chatIdentity() && resource.data.seller_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["is_read", "deleted_by_seller"])
        && request.resource.data.get("is_read", false) is bool
        && request.resource.data.get("deleted_by_seller", false) is bool;
      allow delete: if false;
    }

    // SOCIAL PRESENCE - public fields only; exact GPS coordinates are private.
    match /presence/{uid} {
      allow read: if signedIn()
        && (uid == request.auth.uid
          || (resource.data.discoverable == true
            && resource.data.showOnline == true
            && !blockedBetween(uid, request.auth.uid)));

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && validPresence();

      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /presence_locations/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["latitude", "longitude", "updatedAt"])
        && request.resource.data.keys().hasAll(["latitude", "longitude", "updatedAt"])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.keys().hasAll([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && requestId == pairRequestId(request.resource.data.fromUid, request.resource.data.toUid)
        && exists(/databases/$(database)/documents/presence/$(request.auth.uid))
        && request.resource.data.fromDisplayName == get(/databases/$(database)/documents/presence/$(request.auth.uid)).data.displayName
        && request.resource.data.fromPhotoURL == get(/databases/$(database)/documents/presence/$(request.auth.uid)).data.photoURL
        && exists(/databases/$(database)/documents/presence/$(request.resource.data.toUid))
        && get(/databases/$(database)/documents/presence/$(request.resource.data.toUid)).data.discoverable == true
        && request.resource.data.status == "pending"
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() <= 100
        && request.resource.data.fromPhotoURL is string
        && request.resource.data.fromPhotoURL.size() <= 2048
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !blockedBetween(request.auth.uid, request.resource.data.toUid);

      allow update: if signedIn()
        && resource.data.status in ["pending", "accepted"]
        && request.resource.data.keys().hasOnly([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.keys().hasAll([
          "fromUid", "toUid", "status", "createdAt", "updatedAt",
          "fromDisplayName", "fromPhotoURL"
        ])
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.fromDisplayName == resource.data.fromDisplayName
        && request.resource.data.fromPhotoURL == resource.data.fromPhotoURL
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.status == "pending"
            && resource.data.toUid == request.auth.uid
            && request.resource.data.status == "rejected")
          || (resource.data.status == "pending"
            && resource.data.toUid == request.auth.uid
            && request.resource.data.status == "accepted"
            && !requestBlockedAfter(resource.data.fromUid, resource.data.toUid))
          || (request.resource.data.status == "blocked"
            && resource.data.fromUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(resource.data.toUid)))
          || (request.resource.data.status == "blocked"
            && resource.data.toUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(resource.data.fromUid)))
        );

      // Sender may cancel a pending request. A blocked pair's request may be
      // cleared by either side only once no block remains, so the pair can
      // connect again after unblocking.
      allow delete: if signedIn()
        && (
          (resource.data.fromUid == request.auth.uid
            && resource.data.status == "pending")
          || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && resource.data.status == "blocked"
            && !requestBlockedAfter(resource.data.fromUid, resource.data.toUid))
        );
    }

    match /contacts/{uid}/friends/{friendUid} {
      allow read: if signedIn() && uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "friendUid", "createdAt", "displayName", "photoURL", "status", "requestId"
        ])
        && request.resource.data.keys().hasAll([
          "friendUid", "createdAt", "displayName", "photoURL", "status", "requestId"
        ])
        && request.resource.data.friendUid == friendUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.status == "accepted"
        && validAcceptedContact(uid, friendUid);

      allow update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.friendUid == resource.data.friendUid
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.status == "accepted"
        && request.resource.data.createdAt == resource.data.createdAt;

      // Owner may remove any entry. A user who has blocked the owner may only
      // remove their own entry from the owner's list (block cleanup).
      allow delete: if signedIn()
        && (uid == request.auth.uid
          || (friendUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/user_blocks/$(request.auth.uid)/blocked/$(uid))));
    }

    match /user_blocks/{uid}/blocked/{blockedUid} {
      allow read: if signedIn() && uid == request.auth.uid;

      allow create: if signedIn()
        && uid == request.auth.uid
        && blockedUid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          "blockedUid", "createdAt", "displayName", "photoURL"
        ])
        && request.resource.data.keys().hasAll([
          "blockedUid", "createdAt", "displayName", "photoURL"
        ])
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;

      allow update: if false;
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // Game leaderboard: one document per player, keyed by auth uid. Points are earned
    // client-side (20 per correct answer, up to 100 questions per round), so each write may
    // add at most one full round (2000) and the running total can never go down.
    function validGameScore(uid) {
      let data = request.resource.data;
      return signedIn()
        && request.auth.uid == uid
        && data.uid == uid
        && data.keys().hasOnly(['uid', 'nama', 'skor', 'streak', 'predikat', 'updatedAt'])
        && data.keys().hasAll(['uid', 'nama', 'skor', 'streak', 'predikat', 'updatedAt'])
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 80
        && data.skor is int && data.skor >= 0 && data.skor % 20 == 0
        && data.streak is int && data.streak >= 0 && data.streak <= 100000
        && data.predikat == (data.streak >= 7 ? '🏆 GOLD'
          : data.streak >= 4 ? '🥈 SILVER'
          : data.streak >= 2 ? '🥉 BRONZE' : '')
        && data.updatedAt == request.time;
    }

    match /game_scores/{uid} {
      allow read: if signedIn();
      allow create: if validGameScore(uid)
        && request.resource.data.skor <= 2000;
      allow update: if validGameScore(uid)
        && request.resource.data.skor >= resource.data.skor
        && request.resource.data.skor - resource.data.skor <= 2000;
      allow delete: if isActiveAdmin();
    }

    match /pengumuman_komsel/{document} {
      allow read: if signedIn();
      allow create, delete: if isActiveAdmin();
      allow update: if isActiveAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        && request.resource.data.readBy.toSet().hasAll(resource.data.get("readBy",[]).toSet())
        && request.resource.data.readBy.toSet().difference(resource.data.get("readBy",[]).toSet()).hasOnly([request.auth.token.get("email","")]));
    }

    match /laporan_doa/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /laporan_bacaan/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /kehadiran_jemaat/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /laporan_komsel_umum/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /statistik_jemaat_pusat/{document=**} {
      // Raw report copies remain internal to active administrators.
      allow read: if isActiveAdmin();

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /laporan_pelayanan/{document=**} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isActiveAdmin();
    }

    match /kehadiran/{document} {
      allow read: if isActiveAdmin() || (signedIn() && resource.data.get("uid","") == request.auth.uid);
      allow write: if isActiveAdmin();
    }

    match /kesaksian/{document=**} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.author_uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.author_uid == request.auth.uid;
    }

    match /running_text_history/{document} {
      allow read, write: if isActiveAdmin();
    }

    match /pks_users/{uid} {
      allow read: if
        isActiveAdmin()
        || (signedIn() && uid == request.auth.uid);

      allow create, update, delete: if false;
    }
    match /event_user_hidden/{uid}/events/{eventId} {
      allow read: if
        signedIn()
        && uid == request.auth.uid;

      allow create, update: if
        signedIn()
        && uid == request.auth.uid
        && request.resource.data.hidden == true;

      allow delete: if
        signedIn()
        && uid == request.auth.uid;
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
